# --- Database (Railway Postgres provides this automatically in production) ---
DATABASE_URI=postgres://postgres:postgres@127.0.0.1:5432/guga

# --- Payload ---
# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=CHANGE_ME
# Public origin, used for sitemap/robots/canonical URLs and CORS
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Form e-posta bildirimleri (Google Workspace) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=info@gugalabeltech.com
SMTP_PASS=
MAIL_FROM=info@gugalabeltech.com
MAIL_TO=info@gugalabeltech.com

# --- Cloudflare R2 (media + datasheet storage) ---
# Leave R2_BUCKET empty to fall back to local disk storage during development.
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public base URL of the bucket (custom domain or r2.dev), no trailing slash
R2_PUBLIC_URL=

# --- Seeding ---
# Used once by `npm run seed` to create the first admin user.
SEED_ADMIN_EMAIL=info@gugalabeltech.com
SEED_ADMIN_PASSWORD=CHANGE_ME
